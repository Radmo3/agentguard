{
  "name": "agentguard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/policy -w packages/sim-evm -w packages/sim-solana -w packages/reputation -w packages/sdk && npm run build -w packages/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "tsx examples/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
